# Overpass production environment. Copy to /etc/overpass/agents.env on the VPS
# and fill in the values marked <...>. deploy/install.sh substitutes ${VAR} into
# the rendered configs and the nginx map. NEVER commit the real file: it names
# secrets that are exported into the process environment, not written here.
#
# Secrets (ANS_API_KEY, TRUST_ADMIN_KEY, ANTHROPIC_API_KEY) must be exported in
# the shell / a systemd drop-in, not stored in this file in the repo. The repo
# only ships this .example.

# ---- the one place the domain is set ----------------------------------------
BASE_DOMAIN=blacksburgbytes.club

# ---- ANS production stack (reads only; registration writes are a human step) --
REGISTRY_URL=https://api.godaddy.com
LOG_URL=https://transparency.ans.godaddy.com
LOG_PUBLIC_URL=https://transparency.ans.godaddy.com

# ---- per-agent Agent IDs (from `ans-cli register`, H2) -----------------------
OPS_AGENT_ID=<ops agentId>
AUTHORITY_AGENT_ID=<authority agentId>
GS_BLACKSBURG_AGENT_ID=<gs-blacksburg agentId>
GS_AWARUA_AGENT_ID=<gs-awarua agentId>
GS_SVALBARD_AGENT_ID=<gs-svalbard-eu agentId>
GS_ROGUE_AGENT_ID=<gs-rogue agentId>
AUDITOR_AGENT_ID=<auditor agentId>
SPACECRAFT_AGENT_ID=<spacecraft agentId>

# ---- trust index -------------------------------------------------------------
TRUST_INDEX_URL=https://trust.blacksburgbytes.club
# The admin bearer key is read from this env var by the authority and auditor;
# export the value, do not write it here.
TRUST_ADMIN_KEY_ENV=TRUST_ADMIN_KEY

# ---- LLM planner (H5) --------------------------------------------------------
# export ANTHROPIC_API_KEY=... ; the planner falls back to greedy without it.

# ---- ports (each agent binds 127.0.0.1:<port>; nginx routes by SNI) ----------
OPS_PORT=8443
AUTHORITY_PORT=8445
GS_BLACKSBURG_PORT=8451
GS_AWARUA_PORT=8452
GS_SVALBARD_PORT=8453
GS_ROGUE_PORT=8454
AUDITOR_PORT=8447
SPACECRAFT_PORT=8446

# ---- ANS production transparency-log root keys (public; from the log's
#      /root-keys). Paste as a YAML-safe single line the installer drops into the
#      rendered configs. ----------------------------------------------------------
ANS_ROOT_KEYS=<paste the prod log C2SP root key(s), comma-separated>
